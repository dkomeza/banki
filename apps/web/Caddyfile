# Banki's single origin: the SPA, with the API proxied under /api (ADR-0002).
# Plain HTTP only: TLS belongs to the User's own reverse proxy in front.
{
	admin off
	persist_config off
	auto_https off
	servers {
		# HTTP/2 and HTTP/3 need TLS, which this server never has.
		protocols h1
		# The User's own reverse proxies (BANKI_TRUSTED_PROXIES, space-separated
		# IPs or CIDRs), whose X-Forwarded-For Caddy believes, so {client_ip} is
		# the real client rather than the proxy. Unset, no one is trusted and
		# {client_ip} is the connection's address.
		trusted_proxies static {$BANKI_TRUSTED_PROXIES}
		# Reads X-Forwarded-For right to left, skipping trusted hops, so a
		# client can't pick its own IP by sending the header itself.
		trusted_proxies_strict
	}
}

:8080 {
	encode zstd gzip

	# On every response. The CSP allows only Banki's own origin: theme.js is a
	# file rather than an inline script, so script-src needs no hash, and
	# 'unsafe-inline' lets components set the inline styles they rely on.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# HSTS only when the User opens Banki over HTTPS (BANKI_ORIGIN, read when
	# Caddy starts): over plain HTTP the browser would ignore it anyway, and a
	# User trying Banki on http://localhost shouldn't pin the name to HTTPS.
	@https expression `"{$BANKI_ORIGIN}".startsWith("https://")`
	header @https Strict-Transport-Security "max-age=31536000"

	# The API owns every path under /api, including its 404s, so these never
	# reach the SPA fallback. The prefix is kept: the API's routes include it.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			# Exactly one value: the client's IP. The API trusts it for rate
			# limits and logs, since only this container can reach the API.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Vite names these by content hash, so they never change. A missing one is a
	# real 404, never index.html served as a script.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The web app manifest, by its registered type (not every mime table knows
	# .webmanifest), and revalidated on every load like index.html.
	handle /manifest.webmanifest {
		root * /srv
		header Content-Type application/manifest+json
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the SPA: a built file if one matches, otherwise
	# index.html for a client-side route. Revalidated on every load, so a new
	# deploy is picked up straight away.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
