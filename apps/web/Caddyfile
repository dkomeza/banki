# Banki's single origin: the SPA, with the API proxied under /api (ADR-0002).
# Plain HTTP only: TLS belongs to the User's own reverse proxy in front.
{
	admin off
	persist_config off
	auto_https off
	# HTTP/2 and HTTP/3 need TLS, which this server never has.
	servers {
		protocols h1
	}
}

:8080 {
	encode zstd gzip

	# The API owns every path under /api, including its 404s, so these never
	# reach the SPA fallback. The prefix is kept: the API's routes include it.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# Vite names these by content hash, so they never change. A missing one is a
	# real 404, never index.html served as a script.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the SPA: a built file if one matches, otherwise
	# index.html for a client-side route. Revalidated on every load, so a new
	# deploy is picked up straight away.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
