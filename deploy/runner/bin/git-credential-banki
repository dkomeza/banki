#!/bin/sh
# git's credential helper for https://github.com (ADR-0012), set in the image's
# /etc/gitconfig: asks the broker for an installation token each time git
# needs one, so a push in a long Stage never meets an expired token. The token
# is never stored, so `store` and `erase` do nothing.
set -eu

# git writes what it wants to stdin; github.com is the only host this helper is set for.
cat >/dev/null
[ "${1:-}" = get ] || exit 0

token="$(curl --silent --show-error --fail-with-body --max-time 90 \
  --unix-socket "${BANKI_BROKER_SOCKET:-/run/banki-broker/broker.sock}" \
  http://broker/github/token)" || {
  printf 'git-credential-banki: the broker gave no GitHub token: %s\n' "${token:-is the broker container up?}" >&2
  exit 1
}

printf 'username=x-access-token\npassword=%s\n' "$token"
